# Copy this file to .env and fill in what you need. .env is gitignored — keys never
# reach the browser, and the app runs (without the AI panel) even with none of this set.

# ---- Pick the AI provider ----
# "ollama"     = your local/free model (great for a server you control)
# "openrouter" = one key, many hosted models
# "anthropic"  = Claude API
AI_PROVIDER=ollama

# ---- Ollama (local) ----
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3.5:9b

# num_ctx is the WHOLE window: prompt + reply. The prompt carries game.js, the other project
# files, the lesson and recent turns, so 8192 is not enough — Ollama silently truncates the
# FRONT of an over-long prompt, which drops the output contract and produces malformed edits.
# 16384 fits a 9B model on a 16 GB GPU. Lower it if VRAM is tight.
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=3072

# Reasoning models (Qwen3.x) think before answering, and that thinking is generated from the
# same budget as the answer — on a short JSON job it can eat the lot and return nothing.
# Off by default: measured 15s -> 1s on the grader with no loss of quality. Set to 1 to allow it.
OLLAMA_THINK=0

# ---- Anthropic (cloud) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- OpenRouter (one key, many hosted models) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

PORT=3000

# ---- Per-agent models ----
# Format: provider:model. Blank = AI_PROVIDER + that provider's default model above.
# Examples: ollama:qwen3.5:9b | openrouter:anthropic/claude-sonnet-5 | anthropic:claude-sonnet-5
# One model for all four agents keeps a single model resident and avoids VRAM thrashing.
CODER_MODEL=ollama:qwen3.5:9b
TUTOR_MODEL=ollama:qwen3.5:9b
QUIZ_MODEL=ollama:qwen3.5:9b
GRADER_MODEL=ollama:qwen3.5:9b

# ---- Tool calling, per agent (Stage 4 Tier 2) ----
# Lets an agent look things up — what the student owns, what a lesson says, what is in one of
# their files, the real name of a Phaser API — instead of guessing. Needs a model that supports
# tool calling (qwen3.5 does; qwen2.5-coder does not).
#
# THESE LINES ARE THE ONES PEOPLE PASTE INTO A HOSTING DASHBOARD, so what they say here is what
# the deployment does. They said 0, and a deployed tutor spent its life telling students it had no
# way to read the Phaser docs — while the same code on a laptop read them fine, because the laptop's
# own .env said 1. An explicit 0 beats the default in server.js; there is no default that rescues a
# variable somebody has actually set.
#
# So: ON for the two agents that answer questions. The trade-off is real and worth knowing:
#   - accuracy up, and this is the whole point: 19,000 symbols of the exact Phaser version the
#     student is running, on disk, instead of whatever the model remembers about some other version
#   - latency up: each lookup is another model call, and strict JSON mode and tool calling are
#     mutually exclusive on Ollama, so a JSON agent costs a second call to produce its answer
#     (sprint request: ~6s with tools off, ~25s with them on)
#   - the deterministic Tier 1 validators run either way, so correctness does not depend on this
CODER_TOOLS=1
TUTOR_TOOLS=1
QUIZ_TOOLS=0
GRADER_TOOLS=0
AI_TOOL_ROUNDS=4

# ---- How long one question may take ----
# Nothing bounded this until a tester watched the builder think for six minutes and produce nothing.
# One answer is up to AI_TOOL_ROUNDS lookups plus a final call, and the coder can run that whole
# thing five times over (once per corrective guard) — twenty-five model calls in sequence.
#   AI_CALL_TIMEOUT_MS   ceiling for ONE provider call
#   AI_TOTAL_BUDGET_MS   ceiling for the whole request, retries included. The League server has no
#                        platform timeout, so this is the only clock: 50s is about as long as a
#                        child will wait before deciding the app is broken. Raise it only on a
#                        laptop running a slow local model.
AI_CALL_TIMEOUT_MS=45000
AI_TOTAL_BUDGET_MS=50000

# ============================================================
#  Sign-in (hosted deployments only — see DEPLOY.md)
# ============================================================
# All optional and all OFF until set, which is what keeps a laptop checkout working with no
# accounts at all. Configure ANY provider and the gate is on for the whole app. A provider that is
# only PARTLY configured is a boot failure, not a silent hole.
#
# Why it exists: /api/ai relays to a paid key, and a public URL with an open relay is a free Claude
# proxy for whoever finds it. They never see the key — they just spend it.

# 64 hex chars. Required by every provider. Changing it signs everybody out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_DAYS=14

# ---- Students: the League CodeServer (works like GitHub, has its own OAuth) ----
# Endpoints are configuration because it is the League's own service and still being built.
# Callback to register: https://YOUR-DOMAIN/auth/codeserver/callback
CODESERVER_CLIENT_ID=
CODESERVER_CLIENT_SECRET=
CODESERVER_AUTH_URL=
CODESERVER_TOKEN_URL=
CODESERVER_USER_URL=
CODESERVER_SCOPE=read:user user:email
CODESERVER_NAME=League
# Normally EMPTY: the CodeServer's accounts are the roll. Set it only to pilot with a few students.
ALLOWED_CODESERVER=

# ---- Teachers: Google, restricted to the school domain ----
# Callback: https://YOUR-DOMAIN/auth/google/callback
# Access is decided by the `hd` claim, so the school's own account list does the work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=jointheleague.org
ALLOWED_EMAILS=

# ---- The rare one: GitHub, allowlist only ----
# Callback: https://YOUR-DOMAIN/auth/github/callback
# PREFER NUMERIC IDS. A login can be changed by its owner and the old name reclaimed by someone
# else, so a list of names can quietly come to mean different people. Ids never change.
# An EMPTY list disables GitHub sign-in rather than letting everyone in.
# Not a student route: GitHub requires users to be 13.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB=

# Only if the auto-detected callback origin is ever wrong (it is derived per request).
PUBLIC_ORIGIN=

# ---- The temporary beta door ----
# One shared password, any name typed in the box. Setting it TURNS ON the tester sign-in and turns
# OFF the local bypass, because something is now configured. The name becomes the identity
# (`<name>@tester`), which is what a student's saved work is keyed on — so the names get handed out
# on the call, and two children typing "Jonathan" share one save.
# It is not a security control. Its job is a stable identity per child; the password only keeps a
# crawler off the paid relay. DELETE IT the day the CodeServer's OAuth works. See DEPLOY.md.
TESTER_PASSWORD=

# Shows the login page in its configured shape without signing anybody in — for screenshots and for
# checking the page itself. Any button explains rather than authenticates.  `npm run demo:login`
DEMO_LOGIN=

# ============================================================
#  Saved work — see DEPLOY.md "Saved work"
# ============================================================
# NOTHING HERE IS NEEDED. With none of it set, every student's work is saved to disk in
# app/.data/state — on a laptop, and on the League server, where docker-compose.yml backs that folder
# with a volume. Set a Redis only to share saves between more than one server process.
# UPSTASH_* are Upstash's own names; KV_REST_API_* is an older pair app/store.js still reads.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Where the file backend writes. Defaults to app/.data/state. "none" turns server-side saves off.
STATE_DIR=

# ---- Watching a live session (tools/session-capture.js) ----
# The SSH login that can run `docker compose logs` on the League server, e.g. you@apps.jointheleague.org.
# Not the deploy key's user — that key can only run the deploy script.
SESSION_SSH=
# The folder on the server that holds docker-compose.yml. Defaults to /opt/Game-Dev.
SESSION_DIR=
