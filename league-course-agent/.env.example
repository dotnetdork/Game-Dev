# ---- Pick the AI provider ----
# "ollama"    = your local/free model (great for a server you control)
# "anthropic" = Claude API (key stays on the server, never in the browser)
AI_PROVIDER=ollama

# ---- Ollama (local) ----
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5-coder:7b

# ---- Anthropic (cloud) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

PORT=3000

# ---- Per-agent models (optional) ----
# Format: provider:model. Blank = AI_PROVIDER + OLLAMA_MODEL/ANTHROPIC_MODEL.
# Examples: ollama:qwen2.5-coder:7b | openrouter:qwen/qwen-2.5-coder-7b | anthropic:claude-3-5-sonnet-latest
CODER_MODEL=ollama:qwen2.5-coder:7b
TUTOR_MODEL=ollama:qwen2.5:7b
QUIZ_MODEL=ollama:qwen2.5:7b
GRADER_MODEL=ollama:qwen2.5:7b

# ---- OpenRouter (one key, many hosted models) ----
OPENROUTER_API_KEY=
