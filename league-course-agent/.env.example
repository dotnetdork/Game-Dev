# ---- Pick the AI provider ----
# "ollama"    = your local/free model (great for a server you control)
# "anthropic" = Claude API (key stays on the server, never in the browser)
AI_PROVIDER=ollama

# ---- Ollama (local) ----
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5-coder:7b

# ---- Anthropic (cloud) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

PORT=3000
