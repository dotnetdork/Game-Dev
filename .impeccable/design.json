  "components": [
    {
      "name": "Transport Button",
      "kind": "button",
      "refersTo": "transport-button",
      "description": "Play / Pause / Step, centred in the toolbar: icon plus word, 44px.",
      "html": "<div class=\"ds-transport\"><button class=\"ds-tbtn\"><svg class=\"ds-i\" viewBox=\"0 0 24 24\"><path d=\"M8 5.5v13l10.5-6.5z\"/></svg><span>Play</span></button><button class=\"ds-tbtn\"><svg class=\"ds-i\" viewBox=\"0 0 24 24\"><path d=\"M8.5 5.5v13M15.5 5.5v13\"/></svg><span>Pause</span></button></div>",
      "css": ".ds-i{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;flex:none;}.ds-transport{display:inline-flex;gap:2px;background:#232323;padding:3px;border-radius:7px;}.ds-tbtn{font:15px/1.45 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;display:inline-flex;align-items:center;gap:6px;height:44px;padding:0 14px;border:0;background:#414141;border-radius:5px;color:#cfcfcf;cursor:pointer;}.ds-tbtn span{font-size:14px;font-weight:600;}.ds-tbtn:hover{color:#e8e8e8;}.ds-tbtn:focus-visible{outline:2px solid var(--focus,#fff);outline-offset:2px;}"
    },
    {
      "name": "Transport Button, Playing",
      "kind": "button",
      "refersTo": "transport-button-active",
      "description": "Play turns into Stop in solid League orange while the game runs.",
      "html": "<button class=\"ds-tbtn-on\"><svg class=\"ds-i\" viewBox=\"0 0 24 24\"><rect x=\"6.5\" y=\"6.5\" width=\"11\" height=\"11\" rx=\"1.5\"/></svg><span>Stop</span></button>",
      "css": ".ds-i{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;flex:none;}.ds-tbtn-on{font:15px/1.45 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;display:inline-flex;align-items:center;gap:6px;height:44px;padding:0 14px;border:0;background:#f5820a;color:#1a1206;border-radius:5px;cursor:pointer;}.ds-tbtn-on span{font-size:14px;font-weight:600;}.ds-tbtn-on:focus-visible{outline:2px solid var(--focus,#fff);outline-offset:2px;}"
    },
    {
      "name": "Dialogue Option",
      "kind": "button",
      "refersTo": "dialogue-option",
      "description": "The kid's primary action: an orange-outlined answer under the mentor's latest line.",
      "html": "<div class=\"ds-opts\"><button class=\"ds-opt\">Colours<small>Art</small></button><button class=\"ds-opt\">Sound<small>Audio</small></button></div>",
      "css": ".ds-opts{display:grid;gap:6px;background:#383838;padding:8px 12px;width:340px;}.ds-opt{font:15px/1.45 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:44px;padding:8px 12px;background:transparent;border:1.5px solid #f5820a;border-radius:8px;text-align:left;cursor:pointer;color:#e8e8e8;font-weight:600;transition:background .2s;}.ds-opt small{font-weight:500;color:#b0b0b0;font-size:12.5px;}.ds-opt:hover{background:rgba(245,130,10,.16);}.ds-opt:focus-visible{outline:2px solid var(--focus,#fff);outline-offset:2px;}"
    },
    {
      "name": "Say Field",
      "kind": "input",
      "refersTo": "say-field",
      "description": "'Say something else' — always optional; options mean typing is never required.",
      "html": "<div class=\"ds-say\"><input class=\"ds-say-in\" type=\"text\" placeholder=\"Say something else…\" aria-label=\"Say something else\"></div>",
      "css": ".ds-say{background:#383838;padding:4px 12px 12px;width:340px;}.ds-say-in{width:100%;min-height:44px;border-radius:8px;border:1px solid #444;background:#232323;color:#e8e8e8;padding:0 12px;font:14px system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;}.ds-say-in::placeholder{color:#b0b0b0;}.ds-say-in:focus-visible{outline:2px solid #fff;outline-offset:2px;}"
    },
    {
      "name": "Dock Tab Strip",
      "kind": "nav",
      "refersTo": "dock-tab",
      "description": "Every dock's header: icon, real Unity panel name, kid subtitle.",
      "html": "<div class=\"ds-dock\"><div class=\"ds-tabs\"><span class=\"ds-tab\"><svg class=\"ds-i\" viewBox=\"0 0 24 24\"><path d=\"M5 5h6M8 5v14M8 11h6M8 17h6M15 9h4v4h-4zM15 15h4v4h-4z\"/></svg>Hierarchy <small>your parts</small></span></div><div class=\"ds-body\">…</div></div>",
      "css": ".ds-i{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;flex:none;}.ds-dock{font:15px/1.45 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;background:#383838;color:#e8e8e8;width:264px;}.ds-tabs{background:#282828;display:flex;align-items:flex-end;height:34px;padding:0 6px;}.ds-tab{display:inline-flex;align-items:center;gap:7px;height:30px;padding:0 12px;background:#383838;border-radius:6px 6px 0 0;font-size:14px;font-weight:600;}.ds-tab small{font-weight:500;color:#b0b0b0;font-size:12.5px;}.ds-body{padding:10px 12px;color:#b0b0b0;}"
    },
    {
      "name": "Hierarchy Row",
      "kind": "custom",
      "refersTo": "hierarchy-row",
      "description": "A part of the kid's game; selected turns solid orange and opens the Inspector.",
      "html": "<ul class=\"ds-tree\"><li><button class=\"ds-row\"><svg class=\"ds-i\" viewBox=\"0 0 24 24\"><path d=\"M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12L4 7.5\"/></svg>Level 1<small>the level</small></button></li><li class=\"ds-child\"><button class=\"ds-row\" aria-pressed=\"true\"><svg class=\"ds-i\" viewBox=\"0 0 24 24\"><path d=\"M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12L4 7.5\"/></svg>Player<small>your robot</small></button></li><li class=\"ds-child\"><button class=\"ds-row\" aria-pressed=\"false\"><svg class=\"ds-i\" viewBox=\"0 0 24 24\"><path d=\"M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12L4 7.5\"/></svg>Coin<small>the goal</small></button></li></ul>",
      "css": ".ds-i{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;flex:none;}.ds-tree{list-style:none;margin:0;padding:10px 12px;background:#383838;width:264px;}.ds-row{font:15px/1.45 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;width:100%;display:flex;align-items:center;gap:8px;min-height:44px;padding:0 8px;border:0;background:transparent;border-radius:4px;text-align:left;color:#e8e8e8;cursor:pointer;}.ds-child .ds-row{padding-left:34px;}.ds-row:hover{background:#414141;}.ds-row small{margin-left:auto;color:#b0b0b0;font-size:12px;}.ds-row[aria-pressed=\"true\"]{background:#f5820a;color:#1a1206;}.ds-row[aria-pressed=\"true\"] small{color:#1a1206;}.ds-row:focus-visible{outline:2px solid var(--focus,#fff);outline-offset:2px;}"
    },
    {
      "name": "Mentor Messages",
      "kind": "custom",
      "refersTo": "message-mentor",
      "description": "The mentor, a visiting character and the kid, each with a speaker caption.",
      "html": "<div class=\"ds-log\"><div class=\"ds-msg\"><span class=\"ds-from\">Mentor</span>Look at that!</div><div class=\"ds-msg ds-guest\"><span class=\"ds-from\">Art director</span>Nice eye. Colour tells players what matters.</div><div class=\"ds-msg ds-kid\"><span class=\"ds-from\">Captain Byte</span>building houses and exploring caves</div></div>",
      "css": ".ds-log{font:15px/1.45 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;display:flex;flex-direction:column;gap:8px;padding:8px 12px;background:#383838;color:#e8e8e8;width:340px;}.ds-msg{max-width:94%;padding:9px 12px;border-radius:12px;background:#414141;font-size:15px;line-height:1.4;}.ds-from{display:block;font-size:12px;font-weight:700;color:#b0b0b0;margin-bottom:2px;}.ds-kid{align-self:flex-end;background:#4a3b2a;}.ds-guest{background:#33404f;}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Counts in the Project drawer.",
