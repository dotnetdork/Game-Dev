    },
    {
      "name": "Callout (above a tab)",
      "kind": "custom",
      "refersTo": "callout",
      "description": "Names a panel in one sentence, floating just above its tab and pointing down at it.",
      "html": "<div class=\"ds-callout-wrap\"><div class=\"ds-callout\">This is the Game view: where games run.</div><span class=\"ds-tab\">Game <small>your game</small></span></div>",
      "css": ".ds-callout-wrap{display:grid;gap:10px;justify-items:start;padding:8px;background:var(--tabbar,#282828)} .ds-callout{position:relative;background:var(--callout-paper,#fbf6ea);color:var(--callout-ink,#1d1a12);border-radius:10px;padding:8px 12px;font:14px system-ui,sans-serif;box-shadow:0 6px 18px rgba(0,0,0,.35)} .ds-callout::after{content:\"\";position:absolute;left:28px;bottom:-8px;width:16px;height:16px;background:var(--callout-paper,#fbf6ea);transform:rotate(45deg);border-radius:2px} .ds-tab{display:inline-flex;gap:7px;align-items:center;height:30px;padding:0 12px;background:#383838;border-radius:6px 6px 0 0;color:#e8e8e8;font:600 14px system-ui,sans-serif} .ds-tab small{font-weight:500;color:#b0b0b0;font-size:12.5px}"
    },
    {
      "name": "Inspector dock (stacked above the character dock)",
      "kind": "custom",
      "refersTo": "inspector-slot",
      "description": "Opens as its own dock with its own tab when a part is picked; the character dock below shrinks. Never an overlay.",
      "html": "<div class=\"ds-col\"><section class=\"ds-dock\"><div class=\"ds-strip\"><span class=\"ds-tab\">Inspector <small>Player</small></span></div><div class=\"ds-row\"><span>Gravity<small>Unity: Gravity Scale</small></span><b>4.0</b></div></section><section class=\"ds-dock\"><div class=\"ds-strip\"><span class=\"ds-tab\">Lead programmer</span></div><p class=\"ds-msg\">Turn Gravity up until the dots stay under the spikes.</p></section></div>",
      "css": ".ds-col{display:flex;flex-direction:column;gap:1px;background:#232323;width:320px;font:14px system-ui,sans-serif;color:#e8e8e8} .ds-dock{background:#383838} .ds-strip{background:#282828;height:34px;display:flex;align-items:flex-end;padding:0 6px} .ds-tab{display:inline-flex;align-items:center;gap:7px;height:30px;padding:0 12px;background:#383838;border-radius:6px 6px 0 0;font-weight:600} .ds-tab small{font-weight:500;color:#b0b0b0;font-size:12.5px} .ds-row{display:flex;justify-content:space-between;align-items:center;min-height:44px;padding:0 12px} .ds-row small{display:block;color:#b0b0b0;font-size:12px} .ds-msg{margin:10px 12px;padding:9px 12px;background:#414141;border-radius:12px;font-size:15px}"
    },
    {
      "name": "Switch",
      "kind": "custom",
      "refersTo": "choice-swatch",
      "description": "A 44px on/off control with its state in words (Solid, Hurts player).",
      "html": "<button class=\"ds-switch\" role=\"switch\" aria-checked=\"true\"><i></i><span>On: things stand on it</span></button>",
      "css": ".ds-switch{display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:0 12px 0 8px;border-radius:8px;border:1.5px solid #f5820a;background:#414141;color:#e8e8e8;font:600 14px system-ui,sans-serif;cursor:pointer} .ds-switch i{width:38px;height:22px;border-radius:11px;background:#f5820a;position:relative} .ds-switch i::after{content:\"\";position:absolute;top:3px;left:19px;width:16px;height:16px;border-radius:50%;background:#1a1206} .ds-switch:focus-visible{outline:2px solid #fff;outline-offset:2px}"
    },
    {
      "name": "Choice swatch",
      "kind": "chip",
      "refersTo": "choice-swatch",
      "description": "A 44px choice with a word, and a colour dot for colours; the pick gets the orange ring.",
      "html": "<button class=\"ds-swatch\" aria-pressed=\"true\"><i style=\"background:#ffd23f\"></i>Gold</button> <button class=\"ds-swatch\" aria-pressed=\"false\"><i style=\"background:#5aa8ff\"></i>Sky blue</button>",
      "css": ".ds-swatch{display:inline-flex;align-items:center;gap:7px;min-height:44px;padding:0 10px;border-radius:8px;border:1.5px solid #444;background:#414141;color:#e8e8e8;font:600 13.5px system-ui,sans-serif;cursor:pointer} .ds-swatch i{width:16px;height:16px;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(0,0,0,.35)} .ds-swatch[aria-pressed=\"true\"]{border-color:#f5820a;box-shadow:0 0 0 2px #f5820a} .ds-swatch:hover{background:#4a4a4a} .ds-swatch:focus-visible{outline:2px solid #fff;outline-offset:2px}"
    },
    {
      "name": "Concept card",
      "kind": "card",
      "refersTo": "concept-card",
      "description": "Earned in the conversation after an idea is felt and used; the real names on it.",
      "html": "<div class=\"ds-card\"><b>Gravity</b><p>The game pretends things fall. It’s a number you can tune.</p><dl><dt>Unity</dt><dd>Rigidbody 2D → Gravity Scale</dd></dl></div>",
      "css": ".ds-card{max-width:300px;border-radius:10px;background:#2f2a24;border:1.5px solid #f5820a;padding:12px 14px;color:#e8e8e8;font:14.5px system-ui,sans-serif} .ds-card b{display:block;font-size:16px} .ds-card p{margin:4px 0 8px} .ds-card dl{display:grid;grid-template-columns:auto 1fr;gap:2px 10px;margin:0;font-size:13px} .ds-card dt{color:#cfcfcf} .ds-card dd{margin:0}"
    },
    {
      "name": "Card tile with level",
      "kind": "card",
      "refersTo": "card-tile",
      "description": "A card in the Project drawer: name, a four-step level bar, the level in words.",
      "html": "<button class=\"ds-tile\"><strong>Gravity</strong><span class=\"ds-lvl\"><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i></i></span><small>solid</small></button>",
      "css": ".ds-tile{display:flex;flex-direction:column;justify-content:space-between;gap:4px;width:132px;min-height:76px;padding:8px 10px;border-radius:8px;border:1.5px solid #444;background:#414141;color:#e8e8e8;text-align:left;font:14px system-ui,sans-serif;cursor:pointer} .ds-tile small{color:#b0b0b0;font-size:12px} .ds-lvl{display:flex;gap:3px} .ds-lvl i{width:14px;height:5px;border-radius:2px;background:#555} .ds-lvl i.on{background:#f5820a} .ds-tile:hover{border-color:#f5820a} .ds-tile:focus-visible{outline:2px solid #fff;outline-offset:2px}"
    },
    {
      "name": "Quest checklist",
      "kind": "custom",
      "refersTo": "checklist-item",
      "description": "The shift’s steps, ticked only on evidence from play.",
      "html": "<ul class=\"ds-checks\"><li class=\"done\"><span class=\"b\">✓</span>Play the game</li><li class=\"now\"><span class=\"b\"></span>Tune it in the Inspector</li><li><span class=\"b\"></span>Tune your own game</li></ul>",
      "css": ".ds-checks{list-style:none;margin:0;padding:10px 12px;background:#383838;display:grid;gap:4px;font:14px system-ui,sans-serif;color:#cfcfcf;width:240px} .ds-checks li{display:flex;align-items:center;gap:8px;min-height:30px} .ds-checks .b{width:20px;height:20px;border-radius:5px;border:1.5px solid #b0b0b0;display:grid;place-items:center;font-size:12px} .ds-checks .done{color:#e8e8e8} .ds-checks .done .b{background:#f5820a;border-color:#f5820a;color:#1a1206} .ds-checks .now{color:#e8e8e8;font-weight:600} .ds-checks .now .b{border-color:#f5820a}"
    }
  ],
  "narrative": {
    "northStar": "The Real Engine, Cut Down",
    "overview": "The kid sits at a real Unity editor in its dark skin: charcoal ground, graphite docks butting together on hairlines, tab strips carrying Unity's own panel names. Then everything a first-timer would not use is taken away or turned to the course's purpose, and what stays is drawn at kid size: 15px body type, 44px targets, and every control an icon with a word. It refuses both the candy kid-app layout and the full adult editor dump. It should read as a studio workstation, not a toy and not a worksheet.\n\nThe chrome is deliberately colourless so that two things carry the eye: League orange, which takes over every job Unity gives its selection blue, and the kid's game, which is the only saturated, many-coloured thing on screen. The editor builds itself around the kid: docks not yet revealed sit as faint outlines where they will open, and they fade in as the story reaches them.\n\nDensity is editor density with kid-sized parts: fixed-height bars, tight 6–12px gaps, content centred in its strip. One thing speaks at a time: the mentor's latest line, with its options directly under it.",
    "keyCharacteristics": [
      "Unity dark-skin greys with a single accent, League orange, in Unity's selection-blue role.",
      "Real Unity panel names on every dock tab, with a quiet kid subtitle beside them.",
      "System UI type at kid sizes; icon plus word on every control; 44px minimum targets.",
      "One authored inline-SVG icon set at a single stroke weight.",
      "The kid's game is the brightest, most colourful thing on screen.",
      "Play mode tints the chrome warm and rings the game in orange.",
      "Unrevealed docks are faint outlines, not missing space."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Orange is the only chrome hue. Anything Unity would paint selection blue is orange; nothing else in the chrome is coloured.",
        "section": "colors\r"
      },
      {
        "name": "The Brightest Thing Rule",
        "body": "The kid's game is the only saturated, many-coloured thing on screen. If a piece of chrome would out-shine the game, it is too loud.",
        "section": "colors\r"
      },
      {
        "name": "The Kid Size Rule",
        "body": "Body and messages are 15px; nothing a kid must read is under 12px.",
        "section": "typography\r"
      },
      {
        "name": "The Real Word First Rule",
        "body": "The real Unity word is the name (Title, weight 600); the kid's gloss sits beside or below it (Label, Quiet Ink). The kid learns the real word and is never left without the plain one.",
        "section": "typography\r"
      },
      {
        "name": "The Zoom Rule",
        "body": "The product's editor is a fluid layout that honours browser zoom: at 1366×650 it is exactly the grid above, and when a kid zooms in, text and targets get bigger and the docks reflow (columns shrink before type does). The wireframes in `docs/rework/wireframes/` stand in with a fixed frame scaled to fit the window, which cancels zoom (WCAG 2.2 resize text, 1.4.4); the prototype must not copy that (Jay, 2026-09-25, from the audit).",
        "section": "layout\r"
      },
      {
        "name": "The Builds Around You Rule",
        "body": "Docks open in story order. Until then a dock is a faint outline in its final place, so the layout never jumps and the kid sees where things will come.",
        "section": "layout\r"
      },
      {
        "name": "The Tonal Stack Rule",
        "body": "Docks never cast shadows; they sit flat in their grid and read by tone. Only true overlays (the callout, the key hint, the pops) lift.",
        "section": "elevation"
      },
      {
        "name": "The No Overlay Rule",
        "body": "A panel never lies over another panel. When something needs room (the Inspector, the C# pane), it opens as a dock and its neighbours shrink; what they held stays readable and scrolls to its newest line (Jay, 2026-09-25).",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do take every token from the frontmatter; the `:root` in `docs/rework/wireframes/src/base.css` is the source.",
      "Do give every dock a tab with its real Unity name and a kid subtitle beside it.",
      "Do make every control an icon from the one set plus a word, at least 44px.",
      "Do use League orange for everything Unity paints selection blue, and for nothing decorative.",
      "Do keep the kid's game the most colourful thing on screen; chrome stays grey.",
      "Do show unrevealed docks as a 1px closed outline in their final place.",
      "Do tint the chrome and ring the game in orange while Play mode is on.",
      "Do open the Inspector as its own dock above the character's dock; keep the newest line and the options visible.",
      "Do point a callout at a panel's tab from above.",
      "Do make every step's progress depend on evidence from play, and shuffle answers every time.",
      "Do build the product's editor fluid, so browser zoom makes it bigger (The Zoom Rule).",
      "Do keep the conversation's history, answer every typed idea, and end every picker in \"Something else…\".",
      "Do make a sound only when the kid caused a change, quietly, with one Sound switch for everything."
    ],
    "donts": [
      "Don't take colours, type or components from the legacy `app/public/` styles; they are not authority for the rework.",
      "Don't add a second accent hue to the chrome, or Unity's selection blue.",
      "Don't set text a kid must read below 12px, or messages below 15px.",
      "Don't use icon-only controls, icon fonts, emoji or a second icon set.",
      "Don't show a removed Unity tool (Scene tab, Console, transform tools, account and layout menus) until a quest needs it.",
      "Don't give docks shadows; only overlays lift.",
      "Don't lay a panel over another panel; docks stack and shrink (The No Overlay Rule).",
      "Don't show a control that looks live but does nothing; hide it until a quest needs it (hidden, not greyed out).",
      "Don't scale the product's editor to fit the window; that cancels zoom.",
      "Don't play a sound on a routine tap, or two sounds at once."
    ]
  }
}
